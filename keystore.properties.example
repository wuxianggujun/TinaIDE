# Copy this file to `keystore.properties` for local release signing.
# Do not commit the real `keystore.properties`.

storeFile=keystore/release.jks
storePassword=CHANGE_ME
keyAlias=tinaide
keyPassword=CHANGE_ME

# Optional runtime secrets.
# For local development you can fill them here.
# For GitHub Actions release builds, use repository secrets instead.

# AegisHub telemetry (logs / crashes / feedback).
# Leave empty to disable all reporting: the client logs a clear error and skips
# the upload instead of falling back to any legacy endpoint. AegisHub is the
# only reporting backend; self-host it and create an app + ingest key in its
# console, then fill these three values.
AEGISHUB_BASE_URL=
AEGISHUB_APP_ID=
AEGISHUB_INGEST_KEY=
