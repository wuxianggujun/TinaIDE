<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        :termux-x11-lorie 的库 manifest 按"独立 app"声明了一整套组件：一个带
        MAIN/LAUNCHER 的 MainActivity、一个偏好设置 Activity、一个无障碍服务、
        两个 receiver，以及 WRITE_SECURE_SETTINGS。

        TinaIDE 只消费 libXlorie.so 与 LorieView / CmdEntryPoint 这几个类。这里
        在直接消费者一侧把其余组件挡掉，宿主 app 就不必了解 lorie 的内部结构：
        否则合并结果里会多出第二个启动图标和一个无障碍服务。

        WRITE_SECURE_SETTINGS 只服务于 lorie 的"自动开启无障碍服务"路径
        （KeyInterceptor.launch），TinaIDE 不走该路径，一并移除以免应用市场审核
        质询这个受保护权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:node="remove" />

    <application>
        <activity
            android:name="com.termux.x11.MainActivity"
            tools:node="remove" />
        <activity
            android:name="com.termux.x11.LoriePreferences"
            tools:node="remove" />
        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LoriePreferences$Receiver"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LorieBroadcastReceiver"
            tools:node="remove" />
    </application>

</manifest>
